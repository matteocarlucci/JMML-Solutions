# TinaCMS keys — copy this file to ".env" and paste in your values.
# You get these from your free Tina Cloud account (tina.io) after
# connecting this GitHub repository. Never commit the real .env file.

TINA_CLIENT_ID=your-client-id-here
TINA_TOKEN=your-read-only-token-here

# The branch your live site builds from.
TINA_BRANCH=main
